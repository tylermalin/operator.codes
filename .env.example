# --- Supabase (auth, profiles, subscribers, api_keys, purchases, products) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (billing, tier upgrades) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- Vercel Blob (digital goods storage, private store) ---
# On Vercel: connect a private Blob store to the project and auth is
# injected automatically (BLOB_READ_WRITE_TOKEN, or OIDC + BLOB_STORE_ID).
# Locally: copy BLOB_READ_WRITE_TOKEN from the store's settings only if
# you need gated downloads in dev. Unset = downloads endpoint 503s.
BLOB_READ_WRITE_TOKEN=

# --- Upstash Redis (API rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Email delivery (newsletter dispatch) ---
# Not yet decided which vendor. Resend and Loops.so are both mentioned
# in the PRD as options. RESEND_API_KEY is wired as the default in
# lib/email.ts; swap the implementation if Loops is picked instead.
RESEND_API_KEY=
