# --- Supabase (auth, profiles, api_keys, purchases, products) ---
# Not needed for the free newsletter — subscriber capture runs on
# Resend alone (below), no Supabase dependency. This stays reserved
# for login, the premium dashboard, and paid-tier gating, provisioned
# later; everything degrades to a clean 503 until it is.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (billing, tier upgrades) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# --- Vercel Blob (digital goods storage, private store) ---
# On Vercel: connect a private Blob store to the project and auth is
# injected automatically (BLOB_READ_WRITE_TOKEN, or OIDC + BLOB_STORE_ID).
# Locally: copy BLOB_READ_WRITE_TOKEN from the store's settings only if
# you need gated downloads in dev. Unset = downloads endpoint 503s.
BLOB_READ_WRITE_TOKEN=

# --- Upstash Redis (API rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Resend (subscriber database + welcome email) ---
# The free newsletter's only backing store — no Supabase table.
# Decided over Loops: API-first Contacts/Segments/Broadcasts model
# fits this stack. RESEND_SEGMENT_ID is the Segment (Resend's current
# grouping concept, née "Audience") new subscribers get added to —
# create one in the Resend dashboard first, then paste its id here.
# RESEND_FROM_ADDRESS needs a domain verified in Resend to actually
# send; defaults to hello@operator.codes if unset. Unset
# RESEND_API_KEY = subscribe returns a clean 503, same pattern as
# every other unprovisioned integration in this template.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_FROM_ADDRESS=
